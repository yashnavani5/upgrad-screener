# Backend + local infrastructure. Copy to .env and fill in. Never commit .env.
# The dashboard has its own file: web/.env.example -> web/.env.local. See docs/ARCHITECTURE.md section 8.

# --- Postgres container (docker-compose.yml) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=screener
# Host port for the Docker Postgres (5432 is often taken by a native Postgres install)
POSTGRES_HOST_PORT=5433
PIPELINE_RW_PASSWORD=change-me
WEB_RO_PASSWORD=change-me

# --- Database URLs ---
# Pipeline (pipeline_rw). Superuser URL is only used by `screener db init` to create roles.
DATABASE_URL=postgresql+psycopg://pipeline_rw:change-me@localhost:5433/screener
DATABASE_ADMIN_URL=postgresql+psycopg://postgres:change-me@localhost:5433/screener

# --- Gemini (model names are config, never hardcoded; `screener doctor` lists what your key can use) ---
GEMINI_API_KEY=
GEMINI_MODEL_FAST=
# Optional: leave empty to use GEMINI_MODEL_FAST for everything.
GEMINI_MODEL_SMART=
GEMINI_EMBED_MODEL=

# --- Search router (each optional; an empty key disables the provider) ---
SEARXNG_URL=http://localhost:18080
EXA_API_KEY=
TAVILY_API_KEY=
SERPAPI_API_KEY=
JINA_API_KEY=

# --- Google Sheet publishing ---
# Path to the service-account JSON (keep it outside the repo) OR the JSON itself on one line.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=

# --- Universe (lakhs-scale company registries) ---
# data.gov.in API key (register free at https://data.gov.in); used for MCA Company Master Data.
DATA_GOV_IN_API_KEY=
# Path to the DPIIT recognised-startups CSV you download from Dataful (sign-in required there).
DPIIT_STARTUPS_CSV=

# --- Enrichment sources (later stages) ---
GITHUB_TOKEN=
PRODUCTHUNT_TOKEN=
PDL_API_KEY=

# --- Behaviour ---
# Contact shown in the crawler User-Agent (an email or URL).
USER_AGENT_CONTACT=
RUN_BUDGET_USD=5
RUN_MAX_LLM_CALLS=2000
LOG_LEVEL=INFO
